# Example 2: Dipole Antenna in uniform plasma
# On a weak laptop, should take less than 1 minute

Start(HARPS)

  Start(Grid)
    Nx                      =   40  
    Ny                      =   40 
    Nz                      =   40  
    
    LengthX                 =   0.400             # [m]
    LengthY                 =   0.400             # [m]
    LengthZ                 =   0.400             # [m]
  End(Grid)

  Start(PhysicalParameters)
    RealPermittivity          =   1.0             # [no units, relative quantity]
    Frequency                 =   2.45E9          # [Hz]
    RealMobility              =   0.8             # [m^2/(V s)]
    ImagMobility              =   -2.5            # [m^2/(V s)]
    ElectronDensity           =   1.0E15          # [m^-3]
  End(PhysicalParameters)

  Start(Solver)
    Method                  =   direct_LU         	  # Options: direct_LU, BICGSTAB, GMRES
    Tolerance               =   1.0E-7            # For iterative solvers
    MaxIterations           =   1000              # For iterative solvers
  End(Solver)

  Start(BoundaryConditions)
    X_lower_Boundary        =   PerfectConductor
    X_upper_Boundary        =   PerfectConductor
    Y_lower_Boundary        =   PerfectConductor
    Y_upper_Boundary        =   PerfectConductor
    Z_lower_Boundary        =   PerfectConductor
    Z_upper_Boundary        =   PerfectConductor


    # Source (oscilating charge)
    SourceLocations         =   {(Nx/2, Ny/2, Nz/2)}                      # Array of Points
    SourceValues            =   {[Complex(0,-5);Complex(0,5);0]}        # Array of Values

    # Excitation (fixing amplitudes in a region)
  End(BoundaryConditions)

  Start(PML)                                      # Perfectly Matched Layer
    Enable_X_lower        =   True
    X_lower_Layers        =   14
    Enable_X_upper        =   True
    X_upper_Layers        =   14
    Enable_Y_lower        =   True
    Y_lower_Layers        =   14
    Enable_Y_upper        =   True
    Y_upper_Layers        =   14
    Enable_Z_lower        =   True
    Z_lower_Layers        =   14
    Enable_Z_upper        =   True
    Z_upper_Layers        =   14

    Order                 =   5
    Sigma_0               =   0.8
  End(PML)

  Start(Output)
    PrintMatrix         =   False
    PrintProgress       =   True
    PrintSolution       =   False
    StoreResults        =   True
    PrintConfig         =   True
    OutputDirectory     =   Outputs/
    Fields              =   AbsorbedPower, FieldAmplitudes, FieldRealPart, FieldComponents
  End(Output)

End(HARPS)