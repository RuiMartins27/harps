# Example 9: Nitrogen Reactor Setup in 3D with assumed electrons density (simplified to just waveguide so there are no pml or metal points)
# On a weak laptop (-np 4), does not have enough memory for 64^3 points, with 32^3 should take less than 1 minute

Start(HARPS)

  Start(Grid)
    Nx                      =   32
    Ny                      =   64
    Nz                      =   128
    
    LengthX                 =   0.04318           # [m]
    LengthY                 =   0.0875            # [m]
    LengthZ                 =   0.04318           # [m]

    RefinementFactorX       =   8
    x_BL                    =   0.000            # [m]
    x_RL                    =   0.000            # [m]
    x_RR                    =   0.014            # [m]
    x_BR                    =   0.024            # [m]

    RefinementFactorY       =   8
    y_BL                    =   0.022            # [m]
    y_RL                    =   0.032            # [m]
    y_RR                    =   0.060            # [m]
    y_BR                    =   0.070            # [m]
  End(Grid)

  Start(PhysicalParameters)
    RealPermittivity          =   1.0             # [no units, relative quantity]
    Frequency                 =   2.45E9          # [Hz]
    RealMobility              =   0.8             # [m^2/(V s)]
    ImagMobility              =   -2.5            # [m^2/(V s)]
    ElectronDensity           =   1E11            # [m^-3]
    RealPermittivityLocations =   input/example9_permittivity_points.dat   # Indice of points with different real Permitivity
    RealPermittivityValues    =   input/example9_permittivity_values.dat   # Different values of real Permitivity
    ElectronDensityLocations  =   input/example9_elec_dens_points.dat      # Indice of points with different electron density
    ElectronDensityValues     =   input/example9_elec_dens_values.dat      # Different values of electron density
  End(PhysicalParameters)

  Start(Solver)
    Method                  =   direct_LU          # Options: direct_LU, BICGSTAB, GMRES
    PC                      =   bjacobi           # Pre conditioner: bjacobi, asm, gamg, sor, jacobi, mg, hypre (-np 1), ilu (-np 1), none
    Scalar                  =   -1                 # -1 for vector problem (0 for Ex, 1 for Ey, 2 for Ez)
    Tolerance               =   1.0E-7            # For iterative solvers
    MaxIterations           =   10000             # For iterative solvers
  End(Solver)

  Start(BoundaryConditions)
    X_lower_Boundary        =   Neumann
    X_upper_Boundary        =   PerfectConductor
    Y_lower_Boundary        =   Robin
    Y_upper_Boundary        =   PerfectConductor
    Z_lower_Boundary        =   PerfectConductor
    Z_upper_Boundary        =   PerfectConductor

    Robin_Values = input/example9_excitation_values.dat
  End(BoundaryConditions)

  Start(PML)                                      # Perfectly Matched Layer
    Enable_X_lower        =   False
    Enable_X_upper        =   False
    Enable_Y_lower        =   False
    Y_lower_Layers        =   12
    Enable_Y_upper        =   False
    Y_upper_Layers        =   12
    Enable_Z_lower        =   False
    Z_lower_Layers        =   12
    Enable_Z_upper        =   False
    Z_upper_Layers        =   12

    Order                 =   5
    Sigma_0               =   0.8
  End(PML)

  Start(Output)
    PrintMatrix         =   False
    PrintProgress       =   True
    PrintGrid           =   False
    PrintSolution       =   False
    StoreResults        =   True
    PrintConfig         =   False
    OutputDirectory     =   Outputs/
    Fields              =   AbsorbedPower, FieldAmplitudes, FieldComponents
  End(Output)

End(HARPS)