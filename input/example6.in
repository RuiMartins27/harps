# Example 6: Nitrogen Reactor Setup in 2D non uniform grid with assumed electrons density resembling Altin 2024 (assuming symmetry in the direction of the tube)
# On a weak laptop, should take less than 15 seconds

Start(HARPS)

  Start(Grid)
    Nx                      =   256
    Ny                      =   256
    Nz                      =   1          
    
    LengthX                 =   0.08636            # [m]
    LengthY                 =   0.1400             # [m]
    LengthZ                 =   0.04318            # [m]

    RefinementFactorX       =   4
    x_BL                    =   0.023            # [m]
    x_RL                    =   0.031            # [m]
    x_RR                    =   0.057            # [m]
    x_BR                    =   0.063            # [m]
    
    RefinementFactorY       =   4
    y_BL                    =   0.026            # [m]
    y_RL                    =   0.034            # [m]
    y_RR                    =   0.058            # [m]
    y_BR                    =   0.066            # [m]
  End(Grid)

  Start(PhysicalParameters)
    RealPermittivity          =   1.0             # [no units, relative quantity]
    Frequency                 =   2.45E9          # [Hz]
    RealMobility              =   0.8             # [m^2/(V s)]
    ImagMobility              =   -2.5            # [m^2/(V s)]
    ElectronDensity           =   1.0E11            # [m^-3]
    RealPermittivityLocations =   input/example6_permittivity_points.dat   # Indice of points with different real Permitivity
    RealPermittivityValues    =   input/example6_permittivity_values.dat   # Different values of real Permitivity
    ElectronDensityLocations  =   input/example6_elec_dens_points.dat      # Indice of points with different electron density
    ElectronDensityValues     =   input/example6_elec_dens_values.dat      # Different values of electron density
  End(PhysicalParameters)

  Start(Solver)
    Method                  =   direct_LU         # Options: direct_LU, BICGSTAB, GMRES
    PC                      =   bjacobi           # Pre conditioner: bjacobi, asm, gamg, sor, jacobi, mg, hypre (-np 1), ilu (-np 1), none
    Scalar                  =   2                 # -1 for vector problem (0 for Ex, 1 for Ey, 2 for Ez)
    Tolerance               =   1.0E-8            # For iterative solvers
    MaxIterations           =   50000              # For iterative solvers
    #InitialGuessFile        =   Outputs/fields_solution_direct.bin
  End(Solver)

  Start(BoundaryConditions)
    X_lower_Boundary        =   PerfectConductor
    X_upper_Boundary        =   PerfectConductor
    Y_lower_Boundary        =   Robin
    Y_upper_Boundary        =   Homogeneous
    Z_lower_Boundary        =   None
    Z_upper_Boundary        =   None

    # Source (oscilating charge)
    #SourceLocations      =   input/example6_excitation_points.dat                  # Array of Points in a file
    #SourceValues         =   input/example6_excitation_values.dat                  # Array of Values in a file

    Robin_Values          = input/example6_excitation_values.dat                  # Array of Values in a file

    MetalLocations          =   input/example6_metal_points.dat 
  End(BoundaryConditions)

  Start(PML)                                      # Perfectly Matched Layer
    Enable_X_lower        =   False
    X_lower_Layers        =   50
    Enable_X_upper        =   False
    X_upper_Layers        =   50
    Enable_Y_lower        =   False
    Y_lower_Layers        =   24
    Enable_Y_upper        =   False
    Y_upper_Layers        =   64
    Enable_Z_lower        =   False
    Z_lower_Layers        =   16
    Enable_Z_upper        =   False
    Z_upper_Layers        =   16

    Order                 =   5
    Sigma_0               =   0.8
  End(PML)

  Start(Output)
    PrintMatrix         =   False
    PrintProgress       =   True
    PrintSolution       =   True
    StoreResults        =   True
    PrintConfig         =   False
    PrintGrid           =   False
    OutputDirectory     =   Outputs/
    Fields              =   AbsorbedPower, FieldAmplitudes, FieldRealPart, FieldComponents, PowerFlux, Inputs
  End(Output)

End(HARPS)